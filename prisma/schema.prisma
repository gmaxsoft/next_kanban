generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String    @id @default(uuid()) @db.Char(36)
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String    @db.VarChar(255)
  role          Role      @default(USER)
  avatarUrl     String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  boards        Board[]   @relation("BoardCreator")
  assignedTasks Task[]    @relation("TaskAssignee")
  createdTasks  Task[]    @relation("TaskCreator")
  comments      Comment[]
  chatMessages  ChatMessage[]

  @@index([role])
}

model Account {
  id                String  @id @default(uuid()) @db.Char(36)
  userId            String  @db.Char(36)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  sessionToken String   @unique
  userId       String   @db.Char(36)
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String
  createdAt   DateTime @default(now())
  createdById String   @db.Char(36)
  createdBy   User     @relation("BoardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  columns     Column[]

  @@index([createdById])
}

model Column {
  id      String @id @default(uuid()) @db.Char(36)
  title   String
  order   Int
  boardId String @db.Char(36)
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([boardId])
  @@index([boardId, order])
}

model Task {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String
  description String?  @db.LongText
  priority    Priority @default(MEDIUM)
  order       Int
  columnId    String   @db.Char(36)
  assigneeId  String?  @db.Char(36)
  createdById String   @db.Char(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column    Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments  Comment[]

  @@index([columnId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([columnId, order])
  @@index([priority])
}

model Comment {
  id        String   @id @default(uuid()) @db.Char(36)
  content   String   @db.Text
  taskId    String   @db.Char(36)
  authorId  String   @db.Char(36)
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Char(36)
  content   String   @db.Text
  authorId  String   @db.Char(36)
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId])
}
