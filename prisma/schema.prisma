generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketMessageKind {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum InboundType {
  WEBHOOK
  IMAP
}

model AppRole {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  slug      String   @unique @db.VarChar(64)
  isSystem  Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  users User[]

  @@index([isAdmin])
  @@map("Role")
}

model Team {
  id                       String      @id @default(uuid()) @db.Char(36)
  name                     String      @unique
  description              String?     @db.VarChar(255)
  inboundEmail             String?     @unique @db.VarChar(255)
  inboundType              InboundType @default(WEBHOOK)
  imapHost                 String?     @db.VarChar(255)
  imapPort                 Int?        @default(993)
  imapUser                 String?     @db.VarChar(255)
  imapPassword             String?     @db.VarChar(255)
  imapSecure               Boolean     @default(true)
  imapMailbox              String?     @db.VarChar(120)
  imapAllowedSenderDomains String      @default("pwginfo.pl") @db.VarChar(2000)
  createdAt                DateTime    @default(now())

  users        User[]
  boards       Board[]
  chatMessages ChatMessage[]
  chatReads    ChatTeamRead[]
  tickets      Ticket[]

  @@index([name])
  @@index([inboundType])
}

model User {
  id            String    @id @default(uuid()) @db.Char(36)
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String    @db.VarChar(255)
  roleId        String    @db.Char(36)
  teamId        String?   @db.Char(36)
  isActive      Boolean   @default(true)
  avatarUrl     String?
  createdAt     DateTime  @default(now())

  role            AppRole         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  team            Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  accounts        Account[]
  sessions        Session[]
  boards          Board[]         @relation("BoardCreator")
  taskAssignments TaskAssignee[]
  createdTasks    Task[]          @relation("TaskCreator")
  assignedTickets Ticket[]        @relation("TicketAssignee")
  watchedTickets  TicketWatcher[]
  watchedTasks    TaskWatcher[]
  comments             Comment[]
  chatMessages         ChatMessage[]
  chatTeamReads        ChatTeamRead[]
  notifications        Notification[]
  ticketMessages       TicketMessage[]
  taskAttachments      TaskAttachment[] @relation("TaskAttachmentUploader")
  taskArchives         TaskArchive[]    @relation("TaskArchiveAuthor")

  @@index([roleId])
  @@index([teamId])
  @@index([isActive])
}

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(500)
  href      String?   @db.VarChar(255)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Account {
  id                String  @id @default(uuid()) @db.Char(36)
  userId            String  @db.Char(36)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  sessionToken String   @unique
  userId       String   @db.Char(36)
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String
  createdAt   DateTime @default(now())
  createdById String   @db.Char(36)
  teamId      String   @db.Char(36)
  createdBy   User     @relation("BoardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  columns     Column[]
  archives    TaskArchive[]

  @@index([createdById])
  @@index([teamId])
}

model Column {
  id      String @id @default(uuid()) @db.Char(36)
  title   String
  order   Int
  boardId String @db.Char(36)
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([boardId])
  @@index([boardId, order])
}

model Task {
  id          String    @id @default(uuid()) @db.Char(36)
  title       String
  requestedBy String?   @db.VarChar(255)
  description String?   @db.LongText
  priority    Priority  @default(MEDIUM)
  order       Int
  listOrder   Int       @default(0)
  columnId    String    @db.Char(36)
  dueDate     DateTime?
  createdById String    @db.Char(36)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  column      Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments TaskAssignee[]
  watchers    TaskWatcher[]
  comments    Comment[]
  attachments TaskAttachment[]
  ticket      Ticket?
  archive     TaskArchive?

  @@index([columnId])
  @@index([createdById])
  @@index([columnId, order])
  @@index([listOrder])
  @@index([priority])
  @@index([dueDate])
}

/// Archived tasks (board Archive tab). Table name: Archiwum.
model TaskArchive {
  id            String   @id @default(uuid()) @db.Char(36)
  taskId        String   @unique @db.Char(36)
  boardId       String   @db.Char(36)
  columnId      String   @db.Char(36)
  columnTitle   String   @db.VarChar(160)
  archivedAt    DateTime @default(now())
  archivedById  String   @db.Char(36)

  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  board      Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  archivedBy User   @relation("TaskArchiveAuthor", fields: [archivedById], references: [id], onDelete: Restrict)

  @@index([boardId, archivedAt])
  @@index([archivedById])
  @@map("Archiwum")
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Char(36)
  taskId       String   @db.Char(36)
  uploadedById String   @db.Char(36)
  storedName   String   @unique @db.Char(36)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(255)
  size         Int
  contentHash  String   @db.Char(64)
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([taskId, contentHash])
  @@index([taskId])
  @@index([uploadedById])
}

model TaskAssignee {
  taskId String @db.Char(36)
  userId String @db.Char(36)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskWatcher {
  taskId    String   @db.Char(36)
  userId    String   @db.Char(36)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Char(36)
  content   String   @db.Text
  taskId    String   @db.Char(36)
  authorId  String   @db.Char(36)
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Char(36)
  content   String   @db.Text
  authorId  String   @db.Char(36)
  teamId    String   @db.Char(36)
  createdAt DateTime @default(now())

  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attachments ChatAttachment[]

  @@index([createdAt])
  @@index([authorId])
  @@index([teamId])
  @@index([teamId, createdAt])
}

model ChatTeamRead {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  teamId     String   @db.Char(36)
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model ChatAttachment {
  id           String   @id @default(uuid()) @db.Char(36)
  messageId    String   @db.Char(36)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Ticket {
  id                    String       @id @default(uuid()) @db.Char(36)
  number                Int          @unique @default(autoincrement())
  subject               String       @db.VarChar(255)
  status                TicketStatus @default(OPEN)
  statusLocked          Boolean      @default(false)
  priority              Priority     @default(MEDIUM)
  listOrder             Int          @default(0)
  requesterEmail        String       @db.VarChar(255)
  requesterName         String?      @db.VarChar(160)
  requestedBy           String?      @db.VarChar(255)
  teamId                String?      @db.Char(36)
  assigneeId            String?      @db.Char(36)
  taskId                String?      @unique @db.Char(36)
  acknowledgementSentAt DateTime?    @db.DateTime(3)
  lastMessageAt         DateTime     @default(now())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  team     Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  task     Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  watchers TicketWatcher[]
  messages TicketMessage[]

  @@index([status, lastMessageAt])
  @@index([priority])
  @@index([listOrder])
  @@index([teamId])
  @@index([assigneeId])
  @@index([requesterEmail])
  @@index([createdAt])
}

model TicketWatcher {
  ticketId  String   @db.Char(36)
  userId    String   @db.Char(36)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

model TicketMessage {
  id                String            @id @default(uuid()) @db.Char(36)
  ticketId          String            @db.Char(36)
  kind              TicketMessageKind
  fromEmail         String?           @db.VarChar(255)
  fromName          String?           @db.VarChar(160)
  subject           String?           @db.VarChar(255)
  bodyText          String?           @db.LongText
  bodyHtml          String?           @db.LongText
  externalMessageId String?           @unique @db.VarChar(255)
  authorId          String?           @db.Char(36)
  createdAt         DateTime          @default(now())

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model TicketAttachment {
  id           String   @id @default(uuid()) @db.Char(36)
  messageId    String   @db.Char(36)
  storedName   String   @db.Char(36)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(255)
  size         Int
  contentHash  String   @db.Char(64)
  createdAt    DateTime @default(now())

  message TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, contentHash])
  @@index([messageId, createdAt])
}
