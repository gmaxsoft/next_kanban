generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model AppRole {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique
  slug      String   @unique @db.VarChar(64)
  isSystem  Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  users User[]

  @@map("Role")
  @@index([isAdmin])
}

model Team {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  users        User[]
  boards       Board[]
  chatMessages ChatMessage[]

  @@index([name])
}

model User {
  id            String    @id @default(uuid()) @db.Char(36)
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String    @db.VarChar(255)
  roleId        String    @db.Char(36)
  teamId        String?   @db.Char(36)
  isActive      Boolean   @default(true)
  avatarUrl     String?
  createdAt     DateTime  @default(now())

  role             AppRole        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  team             Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  accounts         Account[]
  sessions         Session[]
  boards           Board[]        @relation("BoardCreator")
  taskAssignments  TaskAssignee[]
  createdTasks     Task[]         @relation("TaskCreator")
  comments         Comment[]
  chatMessages     ChatMessage[]

  @@index([roleId])
  @@index([teamId])
  @@index([isActive])
}

model Account {
  id                String  @id @default(uuid()) @db.Char(36)
  userId            String  @db.Char(36)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  sessionToken String   @unique
  userId       String   @db.Char(36)
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String
  createdAt   DateTime @default(now())
  createdById String   @db.Char(36)
  teamId      String   @db.Char(36)
  createdBy   User     @relation("BoardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  columns     Column[]

  @@index([createdById])
  @@index([teamId])
}

model Column {
  id      String @id @default(uuid()) @db.Char(36)
  title   String
  order   Int
  boardId String @db.Char(36)
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([boardId])
  @@index([boardId, order])
}

model Task {
  id          String    @id @default(uuid()) @db.Char(36)
  title       String
  description String?   @db.LongText
  priority    Priority  @default(MEDIUM)
  order       Int
  columnId    String    @db.Char(36)
  dueDate     DateTime?
  createdById String    @db.Char(36)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  column      Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy   User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments TaskAssignee[]
  comments    Comment[]

  @@index([columnId])
  @@index([createdById])
  @@index([columnId, order])
  @@index([priority])
  @@index([dueDate])
}

model TaskAssignee {
  taskId String @db.Char(36)
  userId String @db.Char(36)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Char(36)
  content   String   @db.Text
  taskId    String   @db.Char(36)
  authorId  String   @db.Char(36)
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Char(36)
  content   String   @db.Text
  authorId  String   @db.Char(36)
  teamId    String   @db.Char(36)
  createdAt DateTime @default(now())

  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attachments ChatAttachment[]

  @@index([createdAt])
  @@index([authorId])
  @@index([teamId])
  @@index([teamId, createdAt])
}

model ChatAttachment {
  id           String   @id @default(uuid()) @db.Char(36)
  messageId    String   @db.Char(36)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}
