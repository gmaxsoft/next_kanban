# MySQL / MariaDB connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/kanban_db"

# Auth.js / NextAuth — wygeneruj sekret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Pierwsze konto ADMIN (npx prisma db seed)
SEED_ADMIN_EMAIL="admin@kanban.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Administrator"

# Powiadomienia e-mail (Resend)
# Bez RESEND_API_KEY wysyłka jest pomijana — UI działa normalnie.
# Na starcie możesz użyć onboarding@resend.dev (tylko na zweryfikowany adres testowy).
RESEND_API_KEY=""
EMAIL_FROM="Next Kanban <onboarding@resend.dev>"

# Tickety z maili przychodzących (Resend Inbound / SendGrid JSON webhook)
# Endpoint: POST /api/webhooks/inbound-email
# Resend: ustaw webhook na event email.received + signing secret (Svix).
RESEND_WEBHOOK_SECRET=""
# Alternatywa / testy: Authorization: Bearer <secret> lub nagłówek x-webhook-secret
INBOUND_EMAIL_WEBHOOK_SECRET=""

# Cron IMAP — GET/POST /api/cron/check-imap
# Authorization: Bearer <CRON_SECRET>
# Wygeneruj: openssl rand -base64 32
# Wywołuj co 1–5 min (Vercel Cron, GitHub Actions, cron systemowy).
CRON_SECRET=""

# Czat Socket.io (osobny proces: npm run chat)
SOCKET_PORT="3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Licencja instalacji (ekran logowania)
# Nazwa firmy-klienta, dla której wystawiasz / sprzedajesz tę kopię.
LICENSE_COMPANY_NAME="Nazwa Firmy Sp. z o.o."
# Opcjonalnie: nazwa sprzedawcy / autora oprogramowania
LICENSE_VENDOR_NAME="MaxSoft.pl"
LICENSE_AUTHOR_NAME="MaxSoft.pl"
# Opcjonalnie: rok w stopce (domyślnie bieżący)
# LICENSE_YEAR="2026"
# Opcjonalnie: własny pełny tekst zamiast domyślnej klauzuli
# LICENSE_NOTICE="Licencja Next Kanban wyłącznie dla …"
