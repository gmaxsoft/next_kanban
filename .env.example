# MySQL / MariaDB connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/kanban_db"

# Auth.js / NextAuth — wygeneruj sekret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Pierwsze konto ADMIN (npx prisma db seed)
SEED_ADMIN_EMAIL="admin@kanban.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Administrator"

# Powiadomienia e-mail (Resend)
# Bez RESEND_API_KEY wysyłka jest pomijana — UI działa normalnie.
# Na starcie możesz użyć onboarding@resend.dev (tylko na zweryfikowany adres testowy).
RESEND_API_KEY=""
EMAIL_FROM="Next Kanban <onboarding@resend.dev>"
